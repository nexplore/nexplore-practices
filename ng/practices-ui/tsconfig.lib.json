{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "outDir": "../dist/out-tsc",
        "declarationMap": true,
        "declaration": true,
        "inlineSources": true,
        "types": []
    },
    "exclude": [
        "src/test.ts",
        "**/*.spec.ts",
        "**/*.stories.ts"
    ],
    "include": [
        "**/*.ts"
    ],
    "angularCompilerOptions": {
      "extendedDiagnostics": {
        "checks": {
          "nullishCoalescingNotNullable": "suppress",
          "optionalChainNotNullable": "suppress"
        }
      }
    }
}
