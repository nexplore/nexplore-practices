{
    "name": "practices-ui-tailwind",
    "$schema": "../node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "generators": {
        "@schematics/angular:component": {
            "standalone": true
        }
    },
    "sourceRoot": "practices-ui-tailwind/src",
    "prefix": "pui",
    "targets": {
        "build": {
            "executor": "@nx/angular:package",
            "dependsOn": [
                "^build"
            ],
            "options": {
                "tsConfig": "practices-ui-tailwind/tsconfig.lib.json",
                "project": "practices-ui-tailwind/ng-package.json"
            },
            "configurations": {
                "production": {
                    "tsConfig": "practices-ui-tailwind/tsconfig.lib.prod.json"
                }
            }
        },
        "storybook": {
            "executor": "@storybook/angular:start-storybook",
            "continuous": true,
            "options": {
                "configDir": "practices-ui-tailwind/.storybook",
                "browserTarget": "practices-ui-tailwind:build-storybook",
                "styles": [
                    "samples-tailwind/src/styles.css"
                ],
                "compodoc": true,
                "compodocArgs": [
                    "-e",
                    "json",
                    "-d",
                    "practices-ui-tailwind"
                ],
                "port": 6006
            },
            "readyWhen": {
                "port": "{env.SBCONFIG_PORT ?? options.port ?? 9009}",
                "host": "{env.SBCONFIG_HOSTNAME ?? options.host ?? localhost}"
            }
        },
        "build-storybook": {
            "executor": "@storybook/angular:build-storybook",
            "outputs": [
                "{options.outputDir}"
            ],
            "options": {
                "configDir": "practices-ui-tailwind/.storybook",
                "browserTarget": "practices-ui-tailwind:build-storybook",
                "styles": [
                    "samples-tailwind/src/styles.css"
                ],
                "compodoc": true,
                "compodocArgs": [
                    "-e",
                    "json",
                    "-d",
                    "practices-ui-tailwind"
                ],
                "outputDir": "dist/storybook/practices-ui-tailwind"
            }
        },
        "static-storybook": {
            "executor": "@nx/web:file-server",
            "dependsOn": [
                "build-storybook"
            ],
            "options": {
                "buildTarget": "practices-ui-tailwind:build-storybook",
                "staticFilePath": "dist/storybook/practices-ui-tailwind",
                "spa": true
            },
            "configurations": {
                "ci": {
                    "buildTarget": "practices-ui-tailwind:build-storybook:ci"
                }
            }
        },
        "build-schematics": {
            "executor": "nx:run-commands",
            "options": {
                "command": "npm run build:schematics",
                "cwd": "{projectRoot}"
            },
            "dependsOn": [
                "build"
            ]
        },
        "test-schematics": {
            "executor": "nx:run-commands",
            "outputs": [
                "{workspaceRoot}/coverage/practices-ui-tailwind-schematics"
            ],
            "options": {
                "command": "jest --config practices-ui-tailwind/jest-schematics.config.js --passWithNoTests=false",
                "cwd": "{workspaceRoot}"
            }
        }
    }
}
