{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "bundler",
        "baseUrl": ".",
        "paths": {
            "@angular/core": ["../angular-22/node_modules/@angular/core"],
            "@angular/core/testing": [
                "../angular-22/node_modules/@angular/core/types/testing.d.ts"
            ],
            "@angular/core/*": ["../angular-22/node_modules/@angular/core/*"],
            "@angular/forms": ["../angular-22/node_modules/@angular/forms"],
            "@angular/forms/signals": [
                "../angular-22/node_modules/@angular/forms/types/signals.d.ts"
            ],
            "@angular/forms/signals/compat": [
                "../angular-22/node_modules/@angular/forms/types/signals-compat.d.ts"
            ],
            "rxjs": ["../angular-22/node_modules/rxjs"],
            "rxjs/*": ["../angular-22/node_modules/rxjs/*"]
        },
        "ignoreDeprecations": "6.0",
        "strict": true,
        "declaration": true,
        "declarationMap": false,
        "outDir": "./out-tsc/lib",
        "skipLibCheck": true,
        "types": []
    },
    "angularCompilerOptions": {
        "enableI18nLegacyMessageIdFormat": false,
        "strictInjectionParameters": true,
        "strictInputAccessModifiers": true,
        "strictTemplates": true
    },
    "files": ["../src/index.ts"]
}
