<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>This package includes common extensions for e-mail handling.</Description>
        <PackageTags>Nexplore.Practices Practices Mail</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Nexplore.Practices.Tests.Integration" />
        <InternalsVisibleTo Include="Nexplore.Practices.Tests.Unit" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="MailKit" Version="4.18.1" />
        <!-- MimeKit 4.18.1 requires Pkcs >= 10.0.0 on all target frameworks. Pin the patched version; the package provides net8.0, net9.0, and net10.0 assets. -->
        <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Nexplore.Practices.Configuration\Nexplore.Practices.Configuration.csproj" />
        <ProjectReference Include="..\Nexplore.Practices.Core\Nexplore.Practices.Core.csproj" />
    </ItemGroup>

</Project>
